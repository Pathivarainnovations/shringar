# Copy this file to frontend/.env.local and edit it:   copy .env.example .env.local
# NEXT_PUBLIC_* values are compiled into the browser code at build time, so rebuild after changing them.

# Base URL of the backend API (no trailing slash, no /api).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: WebSocket endpoint for live tracking pushes. Defaults to NEXT_PUBLIC_API_URL with ws:// and /ws.
# Live tracking works without it (the page also polls every 5 seconds).
# NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
