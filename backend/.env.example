# Copy this file to backend/.env and edit it:   copy .env.example .env
# Never commit the real .env file (it is in .gitignore).

# development | production. In production: sign-in codes are only ever sent by email (never returned
# by the API or logged), cookies are marked Secure, and the dev reset script refuses to run.
NODE_ENV=development

# Port the API listens on, and the exact origin(s) of the website (comma-separated).
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Behind a reverse proxy / HTTPS terminator (production), set to the number of proxies, e.g. 1.
# TRUST_PROXY=1

# First admin. If this email has no account when the server starts, an admin account is created
# without a password. Sign in at /login with "Sign in with a code", then set a password in Profile.
# An existing account is never changed or promoted.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name

# Email for sign-in codes. Production needs ONE of the two options below.
# In development with neither set, codes are printed in this console instead of being emailed.
# Option A - SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B - Resend (https://resend.com)
RESEND_API_KEY=
# Sender shown on the email (used by both options)
MAIL_FROM="Shringar <no-reply@example.com>"

# Optional: location of the SQLite database file (default: ../database/shringar.db)
# DB_FILE=
